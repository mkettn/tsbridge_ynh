#!/bin/bash

# Every question in config_panel.toml binds directly to a KEY: VALUE line
# in config.yaml or tsbridge.env (bind = "key:__INSTALL_DIR__/..."), so
# the core handles reading/writing them on its own -- no custom
# getter/setter/validator needed here.

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

ynh_abort_if_errors

#=================================================
ynh_app_config_run "$1"
