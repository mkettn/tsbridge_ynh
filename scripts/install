#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

### Install parameters are automatically saved as settings, except
### ts_authkey (type = password), which is handled separately below.
### Resources defined in the manifest are provisioned prior to this
### script, so $install_dir and $data_dir are already available.

#=================================================
# INITIALIZE SETTINGS
#=================================================

# ts_hostname is optional with no default in manifest.toml (an
# install-question default can't reference $app -- __APP__ is only
# hydrated in config-panel binds and doc content, not here), so an empty
# answer is resolved to the app's own id here instead.
ts_hostname="${ts_hostname:-$app}"
ynh_app_setting_set --key=ts_hostname --value="$ts_hostname"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Downloads the release binary matching this host's architecture (see
# manifest.toml's resources.sources.main.amd64/.arm64) and places it at
# "$install_dir/tsbridge" (extract = false, rename = "tsbridge").
ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:$app" "$install_dir"
chmod 750 "$install_dir/tsbridge"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template="config.yaml" --destination="$install_dir/config.yaml"
chmod 640 "$install_dir/config.yaml"
chown "$app:$app" "$install_dir/config.yaml"

# ts_authkey (type = password) is *not* auto-saved as an app setting, so
# it's only available here, at install time. It's written straight into
# the service's EnvironmentFile instead of config.yaml (tsbridge reads it
# from TS_AUTHKEY, never from the YAML config) and is left untouched by
# every later script (upgrade explicitly --keeps it; see there).
ynh_config_add --template="tsbridge.env" --destination="$install_dir/tsbridge.env"
chmod 600 "$install_dir/tsbridge.env"
chown "$app:$app" "$install_dir/tsbridge.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated systemd config
ynh_config_add_systemd

yunohost service add "$app" --description="Tailscale-to-Unix-socket bridge"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
