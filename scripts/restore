#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

# Keep this path for calling _common.sh inside the execution's context of backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP MAIN DIR
#=================================================
ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"

chown -R "$app:$app" "$install_dir"
chmod 750 "$install_dir/tsbridge"
chmod 640 "$install_dir/config.yaml"
chmod 600 "$install_dir/tsbridge.env"

# $install_dir itself is 711 (not the more restrictive default) only
# when webui's www/ subdirectory needs to stay reachable by nginx --
# see tsbridge_apply_webui in _common.sh for why.
if [ "$webui" -eq 1 ]; then
    chmod 711 "$install_dir"
    find "$install_dir/www" -type d -exec chmod 755 {} +
    find "$install_dir/www" -type f -exec chmod 644 {} +
else
    chmod 750 "$install_dir"
fi

#=================================================
# RESTORE THE DATA DIRECTORY
#=================================================
ynh_script_progression "Restoring the data directory..."

ynh_restore "$data_dir"

chown -R "$app:$app" "$data_dir"

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Restoring system configurations related to $app..."

ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_systemctl --service=nginx --action=reload

yunohost service add "$app" --description="Tailscale-to-Unix-socket bridge"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"
