#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

### Settings are automatically loaded as bash variables in every app
### script context: $domain, $install_dir, $data_dir, $ts_hostname,
### $control_url... except $ts_authkey (type = password at install time),
### which is never available here -- see install and tsbridge.env below.

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# config.yaml and tsbridge.env aren't part of the downloaded release
# asset (they're rendered separately below / were written once at
# install time) -- keep them through the wipe-and-re-extract.
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="config.yaml tsbridge.env"

chown -R "$app:$app" "$install_dir"
chmod 750 "$install_dir/tsbridge"

#=================================================
# UPDATE CONFIGURATION FILES
#=================================================
ynh_script_progression "Updating $app's configuration files..."

### ynh_config_add keeps track of config.yaml's checksum: if it no longer
### matches what this package last wrote (e.g. the admin hand-added
### bridges: entries, or edited it via SSH), the modified file is backed
### up (suffixed .bkp) before being replaced by a freshly rendered one
### from the current app settings. tsbridge.env is intentionally *not*
### regenerated here -- ts_authkey isn't a persisted setting, so there's
### nothing to render it from; the file --kept above is left as-is.
ynh_config_add --template="config.yaml" --destination="$install_dir/config.yaml"
chmod 640 "$install_dir/config.yaml"
chown "$app:$app" "$install_dir/config.yaml"

chmod 600 "$install_dir/tsbridge.env"
chown "$app:$app" "$install_dir/tsbridge.env"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_systemd

yunohost service add "$app" --description="Tailscale-to-Unix-socket bridge"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
