# Environment file for the tsbridge (__APP__) systemd service.
# Never commit this file or share it; it may hold a Tailscale/Headscale
# auth key. Managed by the tsbridge YunoHost package -- see
# doc/ADMIN.md for how to change it (webadmin config panel, or
# `yunohost app config set __APP__ -k tailnet.ts_authkey -v ...`).

TS_AUTHKEY=__TS_AUTHKEY__
